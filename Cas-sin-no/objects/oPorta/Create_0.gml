//Origin = pé da porta (x, y no chão). Use Creation Code na instância pra mudar:
//   custo = 10; destino = Room2;
custo	= 5;		//Taxa de moedas pra passar (0 = livre)
destino	= noone;	//noone = próxima sala na ordem das salas
aviso	= 0;
abrindo	= false;	//true enquanto toca a animação de abrir
prox	= noone;	//Sala pra onde vai quando a animação acabar